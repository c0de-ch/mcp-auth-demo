# ---------------------------------------------------------------------------
# mcp-auth-demo — environment (copy to .env; .env is git-ignored)
# Every value has a sensible default; PUBLIC_HOST is the one you most likely
# need to set when testing from other machines on your LAN.
# Everything marked DEMO is a well-known demo credential: rotate before any real use.
# ---------------------------------------------------------------------------

# Host name or IP that OTHER machines use to reach this box. Used to build the
# Keycloak issuer URL, the MCP resource URLs and the OAuth callback URL.
# Never "localhost" when the browser/client run on another machine.
# If unset, the code picks the first non-loopback IPv4 address automatically.
PUBLIC_HOST=192.168.1.10

# --- Keycloak (docker compose) ---------------------------------------------
KEYCLOAK_PORT=8180                 # host port; 8080 is often taken
KEYCLOAK_REALM=mcp
#KEYCLOAK_URL=                     # derived: http://${PUBLIC_HOST}:${KEYCLOAK_PORT}; set to point at another Keycloak
KC_ADMIN_USER=admin                # DEMO — admin console + adminLogoutUser()
KC_ADMIN_PASSWORD=admin            # DEMO
MCP_AUDIENCE=mcp-server            # `aud` every MCP access token must carry (comma list allowed)

# --- Client side (examples 03/04/06/07/09/10/11) ---------------------------
OAUTH_CALLBACK_PORT=4199           # loopback listener for the authorization-code redirect
#OAUTH_REDIRECT_HOST=127.0.0.1     # host in the redirect URI; set to PUBLIC_HOST when the browser runs on another machine
#OAUTH_CLIENT_ID=mcp-cli           # empty = Dynamic Client Registration; mcp-cli = the pre-registered public client
#OAUTH_CLIENT_SECRET=              # only for a confidential pre-registered client
#MCP_SERVER_URL=                   # clients: dial this instead of the example's own http://${PUBLIC_HOST}:41NN/mcp
#MCP_BROWSER_CMD=                  # e.g. "python3 scripts/browser-login.py --user alice --password password" (headless login)
#MCP_NO_BROWSER=1                  # print the authorization URL instead of opening a browser
#EXPECT_ADMIN=                     # ok | denied — clients exit 2 when admin_only disagrees (smoke)
#MCP_AUTH_STORE_DIR=               # token store directory (default <repo>/.mcp-auth)

# --- Server side knobs ------------------------------------------------------
#MCP_ALLOWED_HOSTS=mcp.lan,mcp.local   # extra Host header values accepted besides PUBLIC_HOST/localhost
#MCP_LOG=1                             # 0 silences the per-request log on stderr
#MCP_RATE_LIMIT=1                      # 0 disables the SDK auth router's rate limits (tests/smoke do this)

# --- Ports (PORT_<nn>; MCP_PORT overrides any single example) ---------------
#PORT_00=4100  PORT_01=4101  PORT_02=4102  PORT_03=4103  PORT_04=4104  PORT_05=4105
#PORT_06=4106  PORT_07=4107  PORT_08=4108  PORT_09=4109  PORT_10=4110  PORT_11=4111
#PORT_02_ISSUER=4192  PORT_09_INTERNAL=4119  PORT_10_DOWNSTREAM=4190

# --- Example 01: API keys (DEMO) --------------------------------------------
# server table: key:principal:scope scope;… — client picks one key
MCP_API_KEYS="demo-api-key-alice:alice:mcp:tools;demo-api-key-bob:bob:mcp:tools mcp:admin"
MCP_API_KEY=demo-api-key-alice

# --- Example 02: local issuer -----------------------------------------------
#MCP_TOKEN=                        # client: use this token instead of asking the demo issuer
DEMO_USER=alice                    # DEMO — users of the local issuer (02) and the embedded AS (03)
DEMO_PASSWORD=password             # DEMO

# --- Keycloak confidential clients (DEMO) -----------------------------------
MCP_SERVICE_CLIENT_SECRET=mcp-service-secret-demo   # example 05 (client mcp-service)
MCP_SERVER_CLIENT_SECRET=mcp-server-secret-demo     # examples 07/10 (client mcp-server)

# --- Example-specific --------------------------------------------------------
INTROSPECTION_TTL_SECONDS=10                        # 07: positive cache TTL
GATEWAY_INTERNAL_SECRET=gateway-internal-secret-demo   # 09: HS256 secret of the gateway assertion (DEMO)
MTLS_CLIENT=alice                                   # 08: alice | bob | expired-alice | rogue-client | none
