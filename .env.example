# ---------------------------------------------------------------------------
# mcp-auth-demo — environment (copy to .env; .env is git-ignored)
# Every value has a sensible default; PUBLIC_HOST is the one you most likely
# need to set when testing from other machines on your LAN.
# ---------------------------------------------------------------------------

# Host name or IP that OTHER machines use to reach this box. Used to build the
# Keycloak issuer URL, the MCP resource URLs and the OAuth callback URL.
# Never "localhost" when the browser/client run on another machine.
# If unset, the code picks the first non-loopback IPv4 address automatically.
PUBLIC_HOST=192.168.1.10

# --- Keycloak (docker compose) ---------------------------------------------
KEYCLOAK_PORT=8180                 # host port; 8080 is often taken
KEYCLOAK_REALM=mcp
KC_ADMIN_USER=admin                # demo credentials — admin console
KC_ADMIN_PASSWORD=admin

# --- Client-side OAuth callback listener (examples 03/04/06/10) ------------
OAUTH_CALLBACK_PORT=4199

# --- Demo secrets (DEMO ONLY — rotate before using any of this for real) ---
MCP_API_KEY=demo-api-key-alice     # example 01
MCP_SERVICE_CLIENT_SECRET=mcp-service-secret-demo   # example 05 (Keycloak client mcp-service)
MCP_SERVER_CLIENT_SECRET=mcp-server-secret-demo     # examples 07/10 (Keycloak client mcp-server)
