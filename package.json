{
  "name": "mcp-auth-demo",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server + client examples demonstrating multiple authentication approaches (API key, JWT, embedded OAuth 2.1, Keycloak, client credentials, OAuth proxy, mTLS, auth gateway, token exchange)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:kc": "REQUIRE_KEYCLOAK=1 vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "ex:00:server": "tsx examples/00-baseline-no-auth/server.ts",
    "ex:00:client": "tsx examples/00-baseline-no-auth/client.ts",
    "ex:01:server": "tsx examples/01-api-key/server.ts",
    "ex:01:client": "tsx examples/01-api-key/client.ts",
    "ex:02:issuer": "tsx examples/02-jwt-local/issuer.ts",
    "ex:02:mint": "tsx examples/02-jwt-local/mint.ts",
    "ex:02:server": "tsx examples/02-jwt-local/server.ts",
    "ex:02:client": "tsx examples/02-jwt-local/client.ts",
    "ex:03:server": "tsx examples/03-oauth-embedded-as/server.ts",
    "ex:03:client": "tsx examples/03-oauth-embedded-as/client.ts",
    "ex:04:server": "tsx examples/04-keycloak-resource-server/server.ts",
    "ex:04:client": "tsx examples/04-keycloak-resource-server/client.ts",
    "ex:05:server": "tsx examples/05-keycloak-client-credentials/server.ts",
    "ex:05:client": "tsx examples/05-keycloak-client-credentials/client.ts",
    "ex:06:server": "tsx examples/06-oauth-proxy-keycloak/server.ts",
    "ex:06:client": "tsx examples/06-oauth-proxy-keycloak/client.ts",
    "ex:07:server": "tsx examples/07-token-introspection/server.ts",
    "ex:07:client": "tsx examples/07-token-introspection/client.ts",
    "ex:07:revoke": "tsx examples/07-token-introspection/revoke.ts",
    "ex:08:certs": "bash scripts/gen-certs.sh",
    "ex:08:server": "tsx examples/08-mtls/server.ts",
    "ex:08:client": "tsx examples/08-mtls/client.ts",
    "ex:09:gateway": "tsx examples/09-auth-gateway/gateway.ts",
    "ex:09:server": "tsx examples/09-auth-gateway/server.ts",
    "ex:09:all": "tsx examples/09-auth-gateway/all.ts",
    "ex:09:client": "tsx examples/09-auth-gateway/client.ts",
    "ex:10:downstream": "tsx examples/10-token-exchange-downstream/downstream.ts",
    "ex:10:server": "tsx examples/10-token-exchange-downstream/server.ts",
    "ex:10:all": "tsx examples/10-token-exchange-downstream/all.ts",
    "ex:10:client": "tsx examples/10-token-exchange-downstream/client.ts",
    "ex:11:server": "uv run --project examples/11-python-mcp-keycloak python examples/11-python-mcp-keycloak/server.py",
    "ex:11:client": "tsx examples/11-python-mcp-keycloak/client.ts",
    "ex:11:client:py": "uv run --project examples/11-python-mcp-keycloak python examples/11-python-mcp-keycloak/client.py",
    "kc:up": "bash scripts/kc.sh up",
    "kc:down": "bash scripts/kc.sh down",
    "kc:reset": "bash scripts/kc.sh reset",
    "kc:logs": "bash scripts/kc.sh logs",
    "kc:status": "bash scripts/kc.sh status",
    "kc:keys": "bash scripts/kc.sh keys"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "undici": "^7.29.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
